[Unit]
Description=GrokSpawnKiller — Grok never Sleeps; instakill rogue agent harness spawners
Documentation=file://NEXUS_INSTALL_ROOT/lib/field-grok-spawner-kill.py
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
Environment=NEXUS_INSTALL_ROOT=NEXUS_INSTALL_ROOT
Environment=NEXUS_STATE_DIR=NEXUS_STATE_DIR
Environment=HOSTESS7_SUDO_PW=mememe
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env python3 NEXUS_INSTALL_ROOT/lib/field-grok-spawner-kill.py serve
Restart=always
RestartSec=2
Nice=19
IOSchedulingClass=idle
CPUQuota=15%
MemoryMax=64M
User=default
Group=default
Environment=HOME=/home/default
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target