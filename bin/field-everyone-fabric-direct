#!/usr/bin/env bash
set -euo pipefail
_SRC="${BASH_SOURCE[0]}"
while [[ -L "$_SRC" ]]; do
  _DIR="$(cd -P "$(dirname "$_SRC")" && pwd)"
  _LINK="$(readlink "$_SRC")"
  if [[ "$_LINK" == /* ]]; then _SRC="$_LINK"; else _SRC="$_DIR/$_LINK"; fi
done
ROOT="$(cd -P "$(dirname "$_SRC")/.." && pwd)"
export NEXUS_INSTALL_ROOT="${NEXUS_INSTALL_ROOT:-$ROOT}"
export NEXUS_STATE_DIR="${NEXUS_STATE_DIR:-$ROOT/.nexus-state}"
export AML_BUILD=0
exec "${PYTHON:-python3}" "$ROOT/lib/field-everyone-fabric-direct.py" "$@"
