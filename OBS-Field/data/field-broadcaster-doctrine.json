{
  "schema": "field-broadcaster-doctrine/v3",
  "title": "Broadcaster — OBS fork for AmmoOS",
  "product": "Broadcaster",
  "os_brand": "AmmoOS",
  "motto": "OBS verbatim · faster · safer · Final_Eye Ear Mouth wired · ironclad secure.",
  "fork": {
    "upstream": "obs-studio",
    "ref": "30.0.2",
    "ui": "verbatim_obs",
    "web_panel": "launcher_only",
    "root": "OBS-Field",
    "clone": "forge/clone-upstream.sh",
    "build": "build-field-obs.sh"
  },
  "policy": {
    "offline_first": true,
    "no_cloud_login_required": true,
    "no_auto_updates": true,
    "local_recordings_only_default": true,
    "secure_localhost_egress": true,
    "queen_capture_ready": true,
    "web_studio_opt_in": true,
    "scene_guard_default": true
  },
  "engine": {
    "backend": "obs-studio",
    "module": "lib/field-obs-engine.py",
    "senses": "lib/field-broadcaster-senses.py",
    "scene_guard": "OBS-FieldVoiceFilter",
    "threat_hook": "lib/obs-threat-posterity-bridge.py"
  },
  "senses": {
    "doctrine": "data/field-broadcaster-senses-doctrine.json",
    "final_eye": "camera_and_display",
    "final_ear": "audio_input",
    "final_mouth": "voice_output_monitor",
    "optional_drivers": true
  },
  "gui": {
    "surface": "field-broadcaster",
    "native": "obs",
    "launcher": "/field-broadcaster"
  },
  "vision": {
    "camera": "Final_Eye",
    "display": "Final_Eye",
    "audio_in": "Final_Ear",
    "voice": "Final_Mouth",
    "canvas": "Queen CANVAS",
    "bridge": "lib/field-final-eye-canvas-bridge.py"
  },
  "capture": {
    "default_profile": "Broadcaster",
    "default_collection": "NEXUS-C2",
    "record_dir": "recordings",
    "encoder_rtx": "nvenc_h264",
    "encoder_cpu": "h264",
    "format": "mkv"
  },
  "nexus_program": {
    "id": "field-broadcaster",
    "name": "Broadcaster",
    "exec": "/field-broadcaster",
    "native_launch": "field-broadcaster",
    "category": "NEXUS · Media"
  }
}