add_project_arguments('-DFIELD_AMMOOS_OS=1', language: 'c')
add_project_arguments('-DFIELD_AMMOOS_OS=1', language: 'cpp')
add_project_arguments('-DFIELD_AMMOOPAINT_GIMP=1', language: 'c')
add_project_arguments('-DFIELD_AMMOOPAINT_GIMP=1', language: 'cpp')
