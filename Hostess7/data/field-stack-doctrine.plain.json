      "C1_Era",
      "C2_Box",
      "C3_Guard",
      "C4_Wire"
    ],
    "fixed_profiles": [
      "belt_2_0",
      "field_opt",
      "field_physics"
    ],
    "tombstoned_hot_path": [
      "combinatorics-tree",
      "plate-meld",
      "plate-combinatorics-bridge",
      "operator-combinatorics-studio"
    ]
  },
  "ides": {
    "ammocode": {
      "role": "light_loopback_editor",
      "url": "http://127.0.0.1:9555/",
      "repo": "https://github.com/ZacharyGeurts/AmmoCode"
