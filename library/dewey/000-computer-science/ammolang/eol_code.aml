# EOL Code — Layer 0 panel · wiring · fast AML lane (no ironclad hang)
@profile fastest
@verbose clean
@motto "EOL Code — BSP pending (−4) → EOL · wiring gaps · Monster hang guard"

seq ·
  say "EOL Code — AmmoLang fast panel · never raw generator hang"
  post "EOL_CODE START — panel · wiring"
  assist hang
  run py:field-eol-code action:panel timeout:45 stall:20
  run py:field-eol-code action:wiring timeout:30 stall:15
  assist freeze
  say "EOL Code panel ready — F7 /eol-code"
  post "EOL_CODE COMPLETE"