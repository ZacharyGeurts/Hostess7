{
  "schema": "field-dns-dhcp-everywhere-immutable/v1",
  "title": "DNS and DHCP everywhere — immutable on",
  "boss": "hostess7",
  "motto": "Always Field One — Truth DNS + Field DHCP immutable everywhere; everything routes to field-1",
  "always_field_one": true,
  "field_one_hub": {
    "id": "field-1",
    "label": "Field One",
    "dns": ["127.0.0.1", "192.168.47.1"],
    "dhcp": ["192.168.47.1", "0.0.0.0"],
    "truth": "127.0.0.1",
    "loopback": "127.0.0.1",
    "queen_lan": "192.168.47.1",
    "wildcard": "0.0.0.0/0",
    "pages": "https://zacharygeurts.github.io/Hostess7/"
  },
  "policy": {
    "dns_always_on": true,
    "dhcp_always_on": true,
    "immutable_everywhere": true,
    "always_field_one": true,
    "route_all_dns_to_field_one": true,
    "route_all_dhcp_to_field_one": true,
    "field_one_sink": "field-1",
    "disable_env_override": true,
    "boot_seal": true,
    "pages_export": true,
    "legacy_open_secured": true,
    "local_dns_connect": true,
    "truth_dns_option_6": true,
    "never_go_down": true
