  "env_lock": {
    "NEXUS_FIELD_DNS": "1",
    "NEXUS_FIELD_DHCP": "1",
    "NEXUS_FIELD_LOCAL_DNS_CONNECT": "1",
    "NEXUS_LEGACY_OPEN_SECURED": "1",
    "NEXUS_FIELD_DNS_LEGACY_COMPAT": "1",
    "NEXUS_FIELD_DNS_ENFORCE_RESOLV": "1",
    "NEXUS_ALWAYS_FIELD_ONE": "1",
    "NEXUS_NEVER_DOWN": "1"
  },
  "module": "lib/field-dns-dhcp-everywhere-immutable.py",
  "api": "/api/field-dns-dhcp-everywhere-immutable",
  "pages_api": "/api/field-dns-dhcp-everywhere-immutable.json",
  "ironclad_cite": "ironclad:dns-dhcp-everywhere:1"
