{
  "schema": "hostess7-x-sso-fix-doctrine/v2",
  "title": "X login — clean and secure for everyone",
  "motto": "Clean login lane for us and everyone. No stuck modals. No middlemen. TLS-only SSO.",
  "broken_pattern": {
    "url_path": "/i/jf/onboarding/web/sso",
    "symptoms": [
      "data-testid=mask overlay blocks page",
      "role=dialog aria-modal with empty jetfuel-style-root",
      "jf-element divs with slideUp keyframes but no SSO body",
      "Google id_token in query but iframe never mounted"
    ],
    "fix": "early_redirect_to_clean_login"
  },
  "clean_login": {
    "primary": "https://x.com/i/flow/login",
    "google_sso": "https://x.com/i/flow/login?provider=google",
    "apple_sso": "https://x.com/i/flow/login?provider=apple",
    "never_use": [
      "https://x.com/i/jf/onboarding/web/sso?input_flow_data=..."
    ],
    "note": "Broken Jetfuel SSO URLs redirect to /i/flow/login — canonical clean entry for everyone"
  },
  "security": {
    "tls_only": true,
    "no_proxy_injection": true,
    "system_ca_only": true,
    "block_phishing_hosts": true,
    "allowed_login_hosts": [
      "x.com",
      "twitter.com",
      "api.x.com",
      "accounts.google.com",
      "googleapis.com",
      "ssl.gstatic.com",
      "www.gstatic.com",
      "oauth.googleusercontent.com"
    ],
    "never_block_during_login": [
      "accounts.google.com",
      "googleapis.com",
      "oauth.googleusercontent.com",
      "ssl.gstatic.com",
      "www.gstatic.com",
      "api.x.com",
      "abs.twimg.com",
      "pbs.twimg.com"
    ],
    "gone_during_login": ["ads-twitter.com", "t.co", "syndication.twimg.com"]
  },
  "sso_allow": [
    {"host": "x.com", "paths": ["/i/flow/login", "/i/jf/onboarding", "/i/api"], "stars": 5},
    {"host": "api.x.com", "paths": ["/1.1/onboarding", "/graphql"], "stars": 5},
    {"host": "accounts.google.com", "stars": 5},
    {"host": "googleapis.com", "stars": 5},
    {"host": "oauth.googleusercontent.com", "stars": 5},
    {"host": "ssl.gstatic.com", "stars": 5},
    {"host": "www.gstatic.com", "stars": 5}
  ],
  "client_repair": {
    "module": "Hostess7/docs/assets/x-jetfuel-sso-fix.js",
    "early_redirect": true,
    "fallback_login": "/i/flow/login",
    "hosted": "https://zacharygeurts.github.io/Hostess7/x-login/"
  },
  "countermeasures": [
    "hostess7-x-sso-fix.py",
    "x-jetfuel-sso-fix.js early redirect",
    "queen-page-agent jetfuel guard",
    "honorability SSO lane patch"
  ],
  "api": "/api/hostess7-x-sso-fix"
}