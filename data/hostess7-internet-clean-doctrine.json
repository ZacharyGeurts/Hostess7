    "hostess7_compiler": "https://zacharygeurts.github.io/Hostess7/g16-build-output/"
  },
  "ammonet": {
    "product": "AmmoNet",
    "doctrine": "data/ammonet-doctrine.json",
    "final_internet": "data/final-internet-doctrine.json",
    "module": "lib/ammonet-field.py",
    "api": "/api/ammonet",
    "pages_hub": "/ammonet/"
  },
  "notice": "ALL RIGHTS RESERVED is the terms — AmmoNet · Final Internet · HTTPS+Secure · blame terrorist scum · no forks"
}