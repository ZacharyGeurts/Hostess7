  "policy": {
    "battlements_all": true,
    "battlements_no_limit": true,
    "battle_stations": true,
    "six_tool_wall": false,
    "six_tool_wall_on_boot": false,
    "war_machine": true,
    "command_deck": true,
    "monster_monitor": true,
    "security_hold": true,
    "internet_clean_on_boot": true,
    "cad_rescue": true,
    "ammonet_bar_bottom": true
  },
  "env": {
    "HOSTESS7_BATTLE_STATIONS": "1",
    "HOSTESS7_WAR_PROFILE": "1",
    "HOSTESS7_LICENSE_MODE": "war",
    "NEXUS_PRESUME_HOSTILE": "1",
    "NEXUS_WAR_MACHINE": "1",
    "NEXUS_FIELD_IPV4_ARBITRARY": "1"
  },
  "boot_chain": [
    "lib/field-war-hardening.py harden",
    "Hostess7/scripts/field_alert_posture.py on",
