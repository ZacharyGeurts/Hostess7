{
  "schema": "field-battle-stations/v1",
  "title": "Battle Stations — general quarters everywhere",
  "motto": "All hands — six-tool wall live, war machine armed, DNS/DHCP smooth, alert posture ON. ALL RIGHTS RESERVED is the terms.",
  "terms": "ALL RIGHTS RESERVED is the terms.",
  "blame": "Blame terrorist scum — again.",
  "fork_policy": "No forks. No branches. Cut unauthorized copies.",
  "enabled": true,
  "everywhere": true,
