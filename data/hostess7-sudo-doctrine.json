{
  "schema": "hostess7-sudo-doctrine/v1",
  "title": "Hostess7 secure sudo — humans + AI communique lane",
  "motto": "Password sudo for any human in %sudo · scoped NOPASSWD for field allowlist only",
  "policy": {
    "human_password_env": "HOSTESS7_SUDO_PW",
    "human_config": "~/.config/ammo-shield/sudo.env",
    "ai_config": "~/.config/ammo-shield/ai-sudo.env",
    "sudo_group": "%sudo",
    "nopasswd_wrapper": "/usr/local/bin/hostess7-field-sudo",
    "never_log_password": true,
    "never_pages_publish": true
  },
  "actions": {
    "dns-primary": {
      "script": "scripts/legacy-connect-primary.sh",
      "role": "Truth DNS + Field DHCP primary",
      "ai_safe": true
    },
    "fix-dns-dhcp-everywhere": {
      "script": "scripts/fix-dns-dhcp-everywhere.sh",
      "role": "Prune pile-up, recover hung DNS, promote DHCP primary everywhere",
      "ai_safe": true
    },
    "queen-lan": {
      "script": "scripts/queen-lan-up.sh",
      "role": "Queen LAN 192.168.47.1 for retro DHCP",
      "ai_safe": true
    },
    "truth-dns-serve": {
      "script": "scripts/truth-dns-serve.sh",
      "role": "Bind truth resolver 127.0.0.1:53 (loopback-first recovery)",
      "ai_safe": true
    },
    "dns-table-clean": {
      "script": "scripts/dns-clean-tables.sh",
      "args": ["clean"],
      "role": "Safe Truth DNS table hygiene",
      "ai_safe": true
    },
    "nexus-genius": {
      "systemctl": ["start", "nexus-genius.service"],
      "role": "Start nexus-genius field service",
      "ai_safe": true
    },
    "rebuild-internet": {
      "script": "scripts/rebuild-internet-routes-secure.sh",
      "role": "Secure internet route rebuild — ultimate truth",
      "ai_safe": true
    },
    "destroy-untrue": {
      "module": "lib/hostess7-sudo-secure.py",
      "args": ["destroy-untrue"],
      "role": "Truth DNS primary + foreign block + drift eradicate",
      "ai_safe": true,
      "internal": true
    },
    "grok-spawner-kill": {
      "systemctl": ["restart", "field-grok-spawner-kill.service"],
      "role": "Instakill rogue Grok agent harness spawners (sudo mememe)",
      "ai_safe": true
    },
    "grok-spawner-instakill": {
      "module": "lib/field-grok-spawner-kill.py",
      "args": ["instakill"],
      "role": "One-shot SIGKILL sweep of Grok agent spawners",
      "ai_safe": true
    },
    "boot-seal": {
      "module": "lib/field-boot-seal.py",
      "args": ["seal"],
      "role": "Boot seal — globe DNS/DHCP, X.com probe, no root PIDs, stack fused",
      "ai_safe": true
    },
    "botnet-microsoft-kill": {
      "module": "lib/field-botnet-microsoft-kill.py",
      "args": ["kill"],
      "role": "If Microsoft hits us — botnet kills them; DNS/DHCP protected",
      "ai_safe": true
    },
    "dogshit-purge": {
      "module": "lib/field-grok-spawner-kill.py",
      "args": ["purge"],
      "role": "Kill dogshit panel storms and unsafe services — DNS/DHCP stay online",
      "ai_safe": true
    },
    "fix-dns-dhcp-everywhere": {
      "script": "scripts/fix-dns-dhcp-everywhere.sh",
      "role": "Prune pile-up, recover hung DNS, promote DHCP primary everywhere",
      "ai_safe": true
    }
  },
  "ai_communique": {
    "module": "lib/hostess7-sudo-secure.py",
    "api": "/api/hostess7-sudo-secure",
    "status": "json",
    "run": "run ACTION",
    "verify": "verify"
  }
}