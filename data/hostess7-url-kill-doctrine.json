{
  "schema": "hostess7-url-kill-doctrine/v1",
  "title": "URL kill — dangerous shit be gone",
  "motto": "We control the URLs. Dangerous ones are gone — not gated, not delayed, gone.",
  "policy": {
    "gone_not_control": true,
    "strip_from_cache": true,
    "block_egress": true,
    "unwrap_then_kill_shorteners": true,
    "fail_closed": true
  },
  "gone_hosts": [
    "ads-twitter.com",
    "t.co",
    "syndication.twimg.com",
    "periscope.tv",
    "vine.co",
    "doubleclick.net",
    "googlesyndication.com",
    "googleadservices.com",
    "pagead2.googlesyndication.com",
    "adservice.google.com",
    "outbrain.com",
    "taboola.com",
    "popads.net",
    "popcash.net",
    "propellerads.com",
    "exoclick.com",
    "onclickads.net",
    "blockadblock.com",
    "adblockanalytics.com",
    "detectadblock.com",
    "fuckadblock.com",
    "adrecover.com",
    "popup-maker.com",
    "sumome.com",
    "optinmonster.com",
    "privy.com",
    "hellobar.com",
    "disqusads.com"
  ],
  "gone_patterns": [
    "://t\\.co/",
    "://ads-twitter\\.com/",
    "://doubleclick\\.net/",
    "://[^/]*googlesyndication\\.com/",
    "://[^/]*popads\\.net/",
    "curl\\s+[^\\s|]+\\s*\\|\\s*(ba)?sh",
    "javascript:void"
  ],
  "canonical_allow": [
    "x.com",
    "api.x.com",
    "accounts.google.com",
    "googleapis.com",
    "oauth.googleusercontent.com",
    "ssl.gstatic.com",
    "www.gstatic.com",
    "google.com",
    "www.google.com",
    "youtube.com",
    "www.youtube.com",
    "github.com",
    "raw.githubusercontent.com",
    "zacharygeurts.github.io"
  ],
  "gone_marker": "[gone]",
  "blocklist_out": "adblock/domains-gone.txt",
  "api": "/api/operator-url-kill"
}