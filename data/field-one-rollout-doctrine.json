    "require_universal_ingress": true,
    "require_wildcard_any_ip": true,
    "require_field_one_hub": true,
    "require_internet_isolated": true
  },
  "world_regions": "GrokLab/deploy/world-node-regions.json",
  "module": "lib/field-one-rollout.py",
  "api": "/api/field-one-rollout",
  "wires": [
    "lib/field-one.py",
    "lib/field-zachub-qemu-racks.py",
    "lib/field-sovereign-ipv4-enforce.py",
    "lib/grok-lab-world.py"
  ],
