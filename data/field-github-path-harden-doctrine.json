{
  "schema": "field-github-path-harden/v1",
  "presume_mitm": true,
  "presume_hostile_isp": true,
  "default_route": "tunnel",
  "notes": "We are our own DNS — Truth resolver @127.0.0.1:53 is authority. Charter/Spectrum stub is witness only; tunnel ssh.github.com:443 when :22 flaps.",
  "sovereign_dns": {
    "module": "lib/field-dns.py",
    "resolve_module": "lib/field-dns-resolve.py",
    "truth_host": "127.0.0.1",
    "truth_port": 53,
    "stub_witness": "127.0.0.53",
    "primary": "truth_dns",
    "ensure_before_git": true,
    "block_foreign_resolvers": true
  },
  "dns_crosscheck": {
    "primary": "truth_dns",
    "stub_witness": true,
    "doh_witness": false,
    "block_foreign_resolvers": true,
    "doh": [
      {"id": "cloudflare", "url": "https://cloudflare-dns.com/dns-query?name={host}&type=A", "json": true},
      {"id": "google", "url": "https://dns.google/resolve?name={host}&type=A", "json": true}
    ],
    "hosts": ["github.com", "api.github.com", "ssh.github.com"]
  },
  "flap_probe": {"rounds": 3, "interval_sec": 1.5, "timeout_sec": 6},
  "mitigations": {
    "force_tunnel": true,
    "tunnel_first_push": true,
    "skip_api_tls_when_unpinned": true,
    "ipv4_only": true,
    "log_violations": true
  },
  "pinned_connect_ips": {
    "github.com": ["140.82.112.33", "140.82.114.4"],
    "ssh.github.com": ["140.82.112.35", "140.82.114.36"],
    "api.github.com": ["140.82.114.5"]
  }
}