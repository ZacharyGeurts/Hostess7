{
  "schema": "field-botnet-dns-dhcp/v1",
  "title": "Fielded bot network — secure stable DNS & DHCP for everyone through GitHub",
  "boss": "hostess7",
  "motto": "Any and all bot-net nodes — Truth DNS + Field DHCP — stable for everyone · GitHub control plane",
  "for_everyone": {
    "civilian_passthrough": true,
    "dns_truth": true,
    "dhcp_field": true,
    "stable": true,
    "secure": true,
    "legacy_open_secured": true
  },
  "legacy_connect": {
    "module": "lib/field-legacy-connect.py",
    "doctrine": "data/field-legacy-connect-doctrine.json",
    "api": "/api/field-legacy-connect",
    "dreamcast_modem": true,
    "forever": true
  },
  "github_control_plane": {
    "enabled": true,
    "pages": "https://zacharygeurts.github.io/Hostess7/",
    "pages_first": true,
    "middleman": false,
    "registry_pages": "/api/field-endpoint-registry.json",
    "doctrine_api": "/api/field-botnet-dns-dhcp",
    "dns_api": "/api/field-dns",
    "internet_api": "/api/field-internet",
    "catalog": "data/ammoos-pages-hub.json",
    "sync_interval_sec": 120,
    "github_traffic_shard": {
      "module": "lib/field-github-traffic-shard.py",
      "offload_target_pct": 90
    }
  },
  "delay_as_threat": {
    "witnessed": true,
    "doctrine": "data/hostess7-truth-lie-threat-doctrine.json",
    "vector": "DELAY_AS_THREAT",
    "rule": "CI/DNS/deploy stall while local truth ready is hostile — bypass middleman, own deploy",
    "countermeasure": "everyone_deploy.bypass_middleman"
  },
  "everyone_deploy": {
    "bypass_middleman": true,
    "own_deployment": true,
    "motto": "Everyone bypasses middleman — each operator manages own GitHub Pages deploy",
    "deploy_url_pattern": "https://{user}.github.io/{repo}/",
    "workflow": "Hostess7 GitHub Pages",
    "steps": [
      "python3 Hostess7/scripts/hostess7_pages_surfaces_build.py",
      "git add Hostess7/docs/ && git commit -m 'pages: rebuild'",
      "git push origin main",
      "Verify pages-update-status.json deploy stamp"
    ],
    "no_loopback_gate": true
  },
  "bot_network": {
    "member_registry": "lib/field-botnet-registry.py",
    "registry": ".nexus-state/grok-lab-world-registry.json",
    "prefer_member_registry": true,
    "max_qemu_placeholder_nodes": 64,
    "qemu_api": "/api/qemu-world-status",
    "roles": ["dns_relay", "dhcp_relay", "truth_mirror", "github_sync", "power_user"],
    "unified_egress": "hostess7"
  },
  "authorities": {
    "dns": {"module": "lib/field-dns.py", "port": 53, "bind": "127.0.0.1"},
    "dhcp": {"module": "lib/field-dhcp.py", "port": 67, "dns_option": ["127.0.0.1"]}
  },
  "wires": [
    {"id": "internet_unified", "module": "lib/field-internet-unified.py"},
    {"id": "botnet_dns_dhcp", "module": "lib/field-botnet-dns-dhcp.py"},
    {"id": "botnet_legal_ports", "module": "lib/field-botnet-legal-ports.py"},
    {"id": "h7t_truth", "module": "lib/field-h7t-truth.py"},
    {"id": "github_resilience", "module": "lib/field-github-resilience.py"},
    {"id": "github_path_harden", "module": "lib/field-github-path-harden.py", "dns_authority": "lib/field-dns.py"},
    {"id": "dns_drift_threat", "module": "lib/field-dns-drift-threat.py", "api": "/api/field-dns-drift-threat"},
    {"id": "legacy_connect", "module": "lib/field-legacy-connect.py", "api": "/api/field-legacy-connect"},
    {"id": "github_everyone", "module": "lib/field-github-everyone.py"},
    {"id": "gatekeeper", "module": "lib/connection-gatekeeper.py"},
    {"id": "znetwork", "module": "lib/znetwork-orchestrator.py"}
  ],
  "layer": -2,
  "fkey": "F10",
  "ships_with": ["ammoos", "ammonet", "field-internet-unified"]
}